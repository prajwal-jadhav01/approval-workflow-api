{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Claims": "Host=localhost;Port=5432;Database=claims;Username=claims;Password=claims;GSS Encryption Mode=Disable"
  },
  "Workflow": {
    "Enabled": true,
    "GatewayAddress": "localhost:26500"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "claims-approval",
    "Audience": "claims-approval",
    "SigningKey": "",
    "EnableDevTokens": false
  }
}
